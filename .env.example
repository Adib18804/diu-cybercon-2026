# =============================================================================
# DIU_CYBERCON 2026 — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to git.
# Use separate values for dev / staging / production.
# =============================================================================

# ─── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="DIU_CYBERCON 2026"
NEXT_PUBLIC_APP_DESCRIPTION="Bangladesh's flagship national cybersecurity conference, competition, and talent platform."

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase / Neon / local Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://cybercon:cybercon_dev@localhost:5433/cybercon_2026?schema=public"

# Direct connection (used by Prisma migrations; bypass connection pooler)
DIRECT_DATABASE_URL="postgresql://cybercon:cybercon_dev@localhost:5433/cybercon_2026?schema=public"

# ─── NEXTAUTH / AUTH.JS ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"

# Must match NEXT_PUBLIC_APP_URL
AUTH_URL="http://localhost:3000"
# NextAuth client compatibility URL. Keep this origin aligned with AUTH_URL.
NEXTAUTH_URL="http://localhost:3000"

# Session max age in seconds (default: 7 days)
AUTH_SESSION_MAX_AGE=604800

# ─── EMAIL — RESEND ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_REPLACE_WITH_YOUR_RESEND_API_KEY"
EMAIL_FROM="DIU_CYBERCON 2026 <noreply@diucybercon.com>"
EMAIL_REPLY_TO="info@diucybercon.com"

# ─── CLOUDINARY (file storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="REPLACE_WITH_CLOUD_NAME"
CLOUDINARY_API_KEY="REPLACE_WITH_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_API_SECRET"

# Private folder for student ID uploads (NEVER public)
CLOUDINARY_PRIVATE_FOLDER="cybercon2026/private/student-ids"
# Public folder for approved project images, gallery, etc.
CLOUDINARY_PUBLIC_FOLDER="cybercon2026/public"
# Sponsor logos folder
CLOUDINARY_SPONSORS_FOLDER="cybercon2026/public/sponsors"

# ─── QR CODE SIGNING ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
QR_SIGNING_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"
# QR token expiry in seconds (used for check-in validation — not the image TTL)
QR_TOKEN_EXPIRY=86400

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
# Optional: Redis URL for distributed rate limiting (recommended in production)
# Dev (Docker Compose):   redis://:cybercon_redis_dev@localhost:6380
# Production (Upstash):   rediss://:TOKEN@HOST:PORT
# Leave empty to use in-memory rate limiting (dev only — not suitable for prod)
REDIS_URL="redis://:cybercon_redis_dev@localhost:6380"

# ─── SIGNED URL TTL ──────────────────────────────────────────────────────────
# Max seconds for student ID signed URL (must be ≤ 300)
SIGNED_URL_TTL_SECONDS=300

# ─── FILE UPLOAD LIMITS ──────────────────────────────────────────────────────
# Max file size in bytes for student ID upload (default: 5MB)
MAX_STUDENT_ID_SIZE_BYTES=5242880
# Max file size in bytes for project images (default: 10MB)
MAX_PROJECT_IMAGE_SIZE_BYTES=10485760
# Max file size in bytes for poster files (default: 20MB)
MAX_POSTER_FILE_SIZE_BYTES=20971520
# Max file size in bytes for sponsor logos (default: 5MB)
MAX_SPONSOR_LOGO_SIZE_BYTES=5242880

# ─── REGISTRATION ─────────────────────────────────────────────────────────────
# Registration ID prefix (e.g. CYB26-XXXXXX)
REGISTRATION_ID_PREFIX="CYB26"

# ─── ADMIN SEED ──────────────────────────────────────────────────────────────
# Used by prisma/seed.ts to create initial super admin — change immediately after first login
SEED_ADMIN_EMAIL="admin@diucybercon.com"
SEED_ADMIN_PASSWORD="ChangeMe@2026!"
SEED_ADMIN_NAME="Super Admin"

# ─── MONITORING (optional) ────────────────────────────────────────────────────
# Sentry DSN — get from sentry.io
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── ANALYTICS (optional) ─────────────────────────────────────────────────────
# Plausible or Umami — privacy-first analytics
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_URL=""

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS="http://localhost:3000"
# Production: ALLOWED_ORIGINS="https://diucybercon.com,https://www.diucybercon.com"

# ─── FEATURE FLAGS ────────────────────────────────────────────────────────────
# Toggle registration globally (also controllable per-event from admin panel)
NEXT_PUBLIC_REGISTRATION_OPEN=true
# Maintenance mode — shows maintenance page for non-admins
NEXT_PUBLIC_MAINTENANCE_MODE=false
